#!/usr/bin/env bash
set -euo pipefail

: "${FAKE_DOCKER_STATE:?}"
: "${FAKE_SCENARIO:?}"
if [[ "${FAKE_SCENARIO}" != "init-secrets" && "${FAKE_SCENARIO}" != cassandra-* ]]; then
  : "${FAKE_DEPLOYED_IMAGE:?}"
fi

printf '%s\n' "$*" >>"${FAKE_DOCKER_STATE}/calls"

if [[ "${FAKE_SCENARIO}" == cassandra-* ]]; then
  source_volume="${FAKE_LEGACY_VOLUME:-furanocoumarins_cassandra3_data}"
  target_volume="${FAKE_SWARM_VOLUME:-furanocoumarins_swarm_cassandra3_data}"
  case "$1" in
    info)
      printf 'active\n'
      exit 0
      ;;
    compose)
      case "$*" in
        *" ps -q cassandra")
          [[ "${FAKE_SCENARIO}" == "cassandra-stopped" ]] || printf 'legacy-cassandra\n'
          exit 0
          ;;
        *" ps -q --all cassandra")
          printf 'legacy-cassandra\n'
          exit 0
          ;;
        *" ps -q go-auth")
          [[ "${FAKE_SCENARIO}" == "cassandra-stopped" ]] || printf 'legacy-go-auth\n'
          exit 0
          ;;
        *" exec -T cassandra nodetool drain")
          exit 0
          ;;
        *" stop go-auth"|*" stop cassandra"|*" restart cassandra"|*" up -d go-auth")
          exit 0
          ;;
        *" exec -T cassandra cqlsh -e DESCRIBE CLUSTER")
          exit 0
          ;;
      esac
      echo "unsupported Cassandra Compose fake call: $*" >&2
      exit 80
      ;;
    inspect)
      printf '%s\n' "${source_volume}"
      exit 0
      ;;
    ps)
      exit 0
      ;;
    volume)
      action="$2"
      volume="${*: -1}"
      case "${action}" in
        inspect)
          if [[ "${volume}" == "${source_volume}" ]]; then
            [[ "${FAKE_SCENARIO}" != "cassandra-source-missing" ]]
            exit
          fi
          if [[ "${volume}" != "${target_volume}" || ! -f "${FAKE_DOCKER_STATE}/target-exists" ]]; then
            exit 1
          fi
          if [[ "$*" == *'furanocoumarins.cassandra-volume'* ]]; then
            printf 'migration-v1\n'
          elif [[ "$*" == *'furanocoumarins.cassandra-source'* ]]; then
            printf '%s\n' "${source_volume}"
          fi
          exit 0
          ;;
        create)
          : >"${FAKE_DOCKER_STATE}/target-exists"
          printf '%s\n' "${target_volume}"
          exit 0
          ;;
        rm)
          rm -f "${FAKE_DOCKER_STATE}/target-exists"
          exit 0
          ;;
      esac
      ;;
    run)
      if [[ "$*" == *'cat /target/.furanocoumarins-cassandra-migration-v1'* ]]; then
        [[ -f "${FAKE_DOCKER_STATE}/target-ready" ]] || exit 1
        printf 'version=1\nsource=%s\nmanifest=sha256:%064d\n' "${source_volume}" 0
        exit 0
      fi
      if [[ "${FAKE_SCENARIO}" == "cassandra-copy-failure" ]]; then
        exit 81
      fi
      : >"${FAKE_DOCKER_STATE}/target-ready"
      exit 0
      ;;
  esac
  echo "unsupported Cassandra fake Docker call: $*" >&2
  exit 82
fi

if [[ "${FAKE_SCENARIO}" == "init-secrets" ]]; then
  if [[ "$1" == "info" ]]; then
    printf 'active\n'
    exit 0
  fi
  if [[ "$1" == "secret" && "$2" == "inspect" ]]; then
    [[ -f "${FAKE_DOCKER_STATE}/exists-$3" ]]
    exit
  fi
  if [[ "$1" == "secret" && "$2" == "create" ]]; then
    if [[ "$3" == "--label" ]]; then
      label="$4"
      name="$5"
      file="$6"
      printf '%s' "${label}" >"${FAKE_DOCKER_STATE}/label-${name}"
    else
      name="$3"
      file="$4"
    fi
    cp "${file}" "${FAKE_DOCKER_STATE}/secret-${name}"
    : >"${FAKE_DOCKER_STATE}/exists-${name}"
    printf '%s\n' "fake-${name}"
    exit 0
  fi
  echo "unsupported init-secrets fake docker call: $*" >&2
  exit 89
fi

next_count() {
  local name="$1"
  local file="${FAKE_DOCKER_STATE}/${name}.count"
  local value=0
  if [[ -f "${file}" ]]; then
    value="$(<"${file}")"
  fi
  value=$((value + 1))
  printf '%s' "${value}" >"${file}"
  printf '%s' "${value}"
}

if [[ "$1" == "secret" && "$2" == "inspect" ]]; then
  exit 0
fi

if [[ "$1" != "service" ]]; then
  echo "unsupported fake docker call: $*" >&2
  exit 90
fi
shift

case "$1" in
  inspect)
    shift
    if [[ "${1:-}" == "--format" ]]; then
      format="$2"
      service="$3"
      case "${format}" in
        *ContainerSpec.Image*) printf '%s\n' "${FAKE_DEPLOYED_IMAGE}" ;;
        *Replicated.Replicas*)
          if [[ "${service}" == *_go-auth ]]; then
            printf '%s\n' "${FAKE_GO_AUTH_REPLICAS:-4}"
          else
            printf '%s\n' "${FAKE_AUTHD_REPLICAS:-3}"
          fi
          ;;
        *) echo "unsupported inspect format: ${format}" >&2; exit 91 ;;
      esac
    fi
    ;;
  scale)
    exit 0
    ;;
  ps)
    service="${*: -1}"
    if [[ "${service}" == *_auth-import-once ]]; then
		if [[ "${FAKE_SCENARIO}" == "import_ps_error" ]]; then
			echo "simulated importer inspection failure" >&2
			exit 88
		fi
      count="$(next_count importer)"
      case "${FAKE_SCENARIO}" in
        failed) printf 'Failed 1 second ago\n' ;;
        rejected) printf 'Rejected 1 second ago\n' ;;
        import_timeout) printf 'Running 1 second ago\n' ;;
        *)
          if [[ "${count}" -lt 2 ]]; then
            printf 'Running 1 second ago\n'
          else
            printf 'Complete 1 second ago\n'
          fi
          ;;
      esac
    else
		if [[ "${FAKE_SCENARIO}" == "writer_ps_error" ]]; then
			echo "simulated writer inspection failure" >&2
			exit 89
		fi
      count="$(next_count writer)"
      if [[ "${FAKE_SCENARIO}" == "writer_timeout" || "${count}" -le "${FAKE_WRITER_ACTIVE_CALLS:-2}" ]]; then
        printf 'Running 1 second ago\n'
      else
        printf 'Shutdown 1 second ago\n'
      fi
    fi
    ;;
  create)
    if [[ "${FAKE_SCENARIO}" == "writer_timeout" ]]; then
      echo "create called while writers active" >&2
      exit 92
    fi
    ;;
  rm|logs)
    exit 0
    ;;
  *)
    echo "unsupported fake docker service call: $*" >&2
    exit 93
    ;;
esac
