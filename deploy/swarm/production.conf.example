# Copy this file to production.conf and replace every example value.
# Values are literal: do not add shell quotes or export statements.

PUBLIC_APP_ORIGIN=https://furan.example.com

# Use a pinned digest or an explicit non-latest version tag. Tags are safe only
# when your registry enforces immutability; a tag is not a cryptographic pin.
AUTH_MASTER_IMAGE=registry.example.com/auth-master:v1.2.3
FURANO_IMPORT_IMAGE=registry.example.com/furan-import:v1.2.3
FURANO_BACKEND_IMAGE=registry.example.com/furan-backend:v1.2.3
AUTH_POSTGRES_IMAGE=postgres:17.6

AUTH_SMTP_HOST=smtp.example.com
AUTH_MAIL_FROM=auth@example.com

# Existing legacy login or email that the one-shot import promotes.
FURANO_SUPERUSER=admin@example.com
# Running standalone legacy PostgreSQL container. It is attached temporarily
# to an isolated migration overlay; it is not recreated or added to the stack.
LEGACY_POSTGRES_CONTAINER_ID=0123456789ab

# Optional defaults:
# STACK_NAME=furanocoumarins
# AUTH_SMTP_PORT=587
# AUTH_SMTP_USER uses MAIL from env/.env when omitted.
# LEGACY_CASSANDRA_VOLUME=furanocoumarins_cassandra3_data
# SWARM_CASSANDRA_VOLUME defaults to STACK_NAME_swarm_cassandra3_data.
