FROM golang:alpine AS compiler

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
ENV CGO_ENABLED=0 GOOS=linux
RUN --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -ldflags="-s -w" -o /out/import-furanocoumarins ./cmd/import-furanocoumarins

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=compiler /out/import-furanocoumarins /import-furanocoumarins
USER 65532:65532
ENTRYPOINT ["/import-furanocoumarins"]
