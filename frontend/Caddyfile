:8080 {
    @backend path \
        /metadata \
        /metadata-versions \
        /metadata-versions/* \
        /autocomplete/* \
        /article/* \
        /pages/* \
        /ping \
        /auth/* \
        /get-tables-list \
        /create-table \
        /table-imports/* \
        /make-table-active/* \
        /table/* \
        /tables \
        /bibtex

    # /search is also a client-side SPA route. Only requests carrying the API
    # query parameter belong to the backend; a browser navigation to /search
    # must receive index.html instead of the backend's empty-query 400 JSON.
    @search_api {
        path /search
        query q=*
    }

    handle @search_api {
        reverse_proxy {$FURANO_BACKEND_ORIGIN:https://176.108.251.108.nip.io} {
            header_up Host {upstream_hostport}
        }
    }

    handle @backend {
        reverse_proxy {$FURANO_BACKEND_ORIGIN:https://176.108.251.108.nip.io} {
            header_up Host {upstream_hostport}
        }
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
